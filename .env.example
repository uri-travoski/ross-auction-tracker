# =====================================================================
# ross-auction-tracker — secrets and per-deployment settings
# =====================================================================
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Non-secret behaviour lives in config.yaml.

# ---------------------------------------------------------------------
# GitHub / GHCR — used to pull the prebuilt image and to push updates.
# The token needs read:packages to pull, write:packages to push.
# ---------------------------------------------------------------------
GITHUB_USERNAME=uri-travoski
GITHUB_TOKEN=
# Image coordinates referenced by docker-compose.yml.
IMAGE=ghcr.io/uri-travoski/ross-auction-tracker:latest

# ---------------------------------------------------------------------
# Timezone. The auction house is in Perth, WA. Keep this unless you want
# log timestamps and the daily discovery time in a different zone.
# ---------------------------------------------------------------------
TZ=Australia/Perth

# ---------------------------------------------------------------------
# Web report UI
# ---------------------------------------------------------------------
# Host port for the report UI -> http://localhost:8080
WEB_PORT=8080
# Optional HTTP basic auth. Leave both blank to disable authentication.
WEB_USERNAME=
WEB_PASSWORD=

# ---------------------------------------------------------------------
# Email notifications (SMTP). Requirement: reminder emails 3 hours and
# 30 minutes before each auction closes, plus new-auction and
# significant-change alerts.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (587) | ssl (465) | none (25, unauthenticated relay)
SMTP_SECURITY=starttls
SMTP_USERNAME=you@example.com
# For Gmail this must be a 16-character App Password, not your login
# password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
SMTP_FROM=Ross Auction Tracker <you@example.com>
# MULTIPLE RECIPIENTS: comma-separated. All of these receive every alert.
SMTP_RECIPIENTS=you@example.com,someone.else@example.com
# Optional extra recipients that ONLY receive the pre-close reminders.
SMTP_REMINDER_RECIPIENTS=

# ---------------------------------------------------------------------
# AI providers. Fill in the keys for whichever you want to use — the
# agent uses the first available provider per task and falls back to the
# next on failure. Provider URLs/models are configured in config.yaml
# under ai.providers, where you can also add your own.
# ---------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Only needed if your local/self-hosted endpoint requires a key.
OLLAMA_API_KEY=
# Custom provider keys (see ai.providers in config.yaml):
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------
# Overrides for anything in config.yaml. Prefix AT__, nest with __.
# ---------------------------------------------------------------------
# AT__AI__ENABLED=false
# AT__FETCH__CLIENT=playwright
# AT__WEB__PAGE_SIZE=250
# AT__SCHEDULE__CHANGE_EVERY_HOURS=3
# AT__LOGGING__LEVEL=DEBUG

# Set to 1 to skip sending real email and log the messages instead.
NOTIFY_DRY_RUN=0
